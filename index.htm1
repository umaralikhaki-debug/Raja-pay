<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Repayment Link Generator</title>
<style>
*{box-sizing:border-box;font-family:Arial,sans-serif}
body{margin:0;background:#f5f5f5}
/* --- GENERATOR PAGE --- */
.gen-box{max-width:500px;margin:15px auto;background:#fff;padding:20px;border-radius:16px}
.gen-box h2{text-align:center;color:#e85d1f;margin:0}
.gen-box p{text-align:center;color:#777;font-size:13px}
label{font-weight:bold;display:block;margin-top:13px;font-size:14px}
input{width:100%;padding:12px;margin-top:5px;border:1px solid #ccc;border-radius:10px;font-size:15px}
button{width:100%;padding:14px;margin-top:15px;border:none;border-radius:12px;font-weight:bold;font-size:16px;cursor:pointer}
.btn-gen{background:#e85d1f;color:#fff}
.btn-copy{background:#111;color:#fff}
.btn-wa{background:#25D366;color:#fff}
#genResult{display:none;background:#fff3ec;padding:12px;border-radius:10px;word-break:break-all;margin-top:15px;font-size:13px}
small{color:#888;font-weight:normal}

/* --- CUSTOMER REPAYMENT PAGE --- */
.topbar{background:#f26722;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:14px 15px;font-size:22px;font-weight:bold}
.topbar span{font-size:22px}
.card{max-width:480px;margin:15px auto;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.05)}
.pending{background:#f26722;color:#fff;padding:16px 20px;display:flex;justify-content:space-between;align-items:center}
.pending b{font-size:18px;font-weight:600}
.pending .days{font-size:17px}
.pending .days b{font-size:34px;margin-right:8px}
.amounts{display:flex;padding:25px 10px;text-align:center}
.amounts div{flex:1}
.amounts div:first-child{border-right:1px solid #eee}
.amounts .lbl{color:#777;font-size:14px}
.amounts .val{font-size:30px;font-weight:bold;margin-top:10px}
.channel-sec{padding:0 20px}
.channel-sec h3{margin:5px 0 12px;font-size:20px}
.channels{display:flex;flex-wrap:wrap;gap:10px}
.channels button{width:auto;padding:9px 16px;border:1px solid #f26722;background:#fff;color:#f26722;border-radius:8px;font-size:16px;cursor:pointer}
.channels button.active{background:#f26722;color:#fff}
.btn-row{display:flex;gap:12px;padding:20px}
.btn-row button{flex:1;padding:14px;border-radius:10px;font-size:19px;cursor:pointer}
.btn-repay{background:#f26722;color:#fff;border:none}
.btn-ext{background:#fff;color:#f26722;border:1px solid #f26722}
.voucher{color:#2f6fed;text-align:right;padding:0 20px;font-size:17px;cursor:pointer}
.warn{margin:18px 15px 5px;border:1px solid #f0a8a8;border-radius:14px;padding:16px;color:#888;font-size:15px;line-height:1.5;position:relative}
.warn-icon{position:absolute;top:-14px;left:10px;background:#e53935;color:#fff;width:28px;height:28px;border-radius:50%;text-align:center;line-height:28px;font-weight:bold}
.unlocked{text-align:center;padding:15px;font-size:15px}
.auto{text-align:center;color:#f26722;padding:25px 0 40px;font-size:19px}
.selected-upi{text-align:center;font-size:13px;color:#666;padding:0 20px}
</style>
</head>
<body>

<div id="generatorPage">
<div class="gen-box">
<h2>Repayment Link Banao</h2>
<p>Har dafa sab kuch naya daalo, kuch save nahi hoga</p>

<label>Business Name <small>- Yehi naam customer ko nazar ayega</small></label>
<input id="biz" placeholder="e.g. Mera Loan Service">

<label>Customer Name</label>
<input id="cname" placeholder="Customer ka naam">

<label>Customer Mobile</label>
<input id="cmobile" placeholder="0300xxxxxxx" type="tel">

<label>Days Left</label>
<input id="days" type="number" placeholder="e.g. 2">

<label>Extension Amount (₹)</label>
<input id="extAmt" type="number" placeholder="e.g. 1600">

<label>Full Repayment Amount (₹)</label>
<input id="fullAmt" type="number" placeholder="e.g. 4000">

<label>Unlocked For Repeat Loans Amount (₹)</label>
<input id="unlocked" type="number" placeholder="e.g. 5000" value="5000">

<label>Channel 1 UPI</label>
<input id="upi1" placeholder="Channel 1 UPI">

<label>Channel 2 UPI</label>
<input id="upi2" placeholder="Channel 2 UPI">

<label>Channel 3 UPI</label>
<input id="upi3" placeholder="Channel 3 UPI">

<label>Channel 4 UPI</label>
<input id="upi4" placeholder="Channel 4 UPI">

<label>Channel 5 UPI</label>
<input id="upi5" placeholder="Channel 5 UPI">

<button class="btn-gen" onclick="makeLink()">Link Banao</button>

<div id="genResult">
<b>Customer Link:</b><br><span id="linkText"></span><br><br>
<button class="btn-copy" onclick="copyLink()">Link Copy Karo</button>
<button class="btn-wa" onclick="sendWA()">WhatsApp Par Bhejo</button>
</div>
</div>
</div>

<div id="customerPage" style="display:none">
<div class="topbar"><span>‹</span><span id="showBiz">Business</span><span>☰</span></div>
<div class="card">
<div class="pending"><b>Pending Repayment</b><span class="days"><b id="showDays">2</b> Days left</span></div>
<div class="amounts">
<div><div class="lbl">A Tenure Extension/₹</div><div class="val" id="showExt">1,600</div></div>
<div><div class="lbl">Repayment Amount / ₹</div><div class="val" id="showFull">4,000</div></div>
</div>
<div class="channel-sec">
<h3>Repayment Channel</h3>
<div class="channels" id="channelBtns"></div>
</div>
<div class="selected-upi" id="selectedUpi"></div>
<div class="btn-row">
<button class="btn-repay" onclick="payNow('Full')">Repay</button>
<button class="btn-ext" onclick="payNow('Extension')">Extension</button>
</div>
<div class="voucher">Repayment Voucher Entry ›</div>
<div class="warn"><span class="warn-icon">!</span>Repay on time to improve your credit score. Please pay only on this official page.</div>
<div class="unlocked">Unlocked For Repeat Loans ₹<span id="showUnlocked">5000.00</span></div>
</div>
<div class="auto">Auto-Schedule Next Loan ›</div>
</div>

<script>
let finalLink = "";
let currentCustomer = "";
let currentMobile = "";
let channels = [];
let selectedChannel = 0;
let extAmtVal = "", fullAmtVal = "", bizVal = "";

function getParam(name){
  let url = new URL(window.location.href);
  return url.searchParams.get(name);
}

function makeLink(){
  let biz = document.getElementById('biz').value.trim();
  let cname = document.getElementById('cname').value.trim();
  let cmobile = document.getElementById('cmobile').value.trim();
  let days = document.getElementById('days').value.trim();
  let ext = document.getElementById('extAmt').value.trim();
  let full = document.getElementById('fullAmt').value.trim();
  let unlocked = document.getElementById('unlocked').value.trim() || "5000";
  let upi1 = document.getElementById('upi1').value.trim();
  let upi2 = document.getElementById('upi2').value.trim();
  let upi3 = document.getElementById('upi3').value.trim();
  let upi4 = document.getElementById('upi4').value.trim();
  let upi5 = document.getElementById('upi5').value.trim();

  if(!biz || !cname || !ext || !full || !upi1){ alert("Business Name, Customer Name, Dono Amounts aur Channel 1 UPI zaroori hai"); return; }

  let base = window.location.origin + window.location.pathname;
  let params = new URLSearchParams();
  params.set('biz', biz);
  params.set('cname', cname);
  params.set('days', days || "2");
  params.set('ext', ext);
  params.set('full', full);
  params.set('unlocked', unlocked);
  params.set('upi1', upi1);
  if(upi2) params.set('upi2', upi2);
  if(upi3) params.set('upi3', upi3);
  if(upi4) params.set('upi4', upi4);
  if(upi5) params.set('upi5', upi5);

  finalLink = base + "?" + params.toString();
  currentCustomer = cname;
  currentMobile = cmobile;

  document.getElementById('linkText').innerText = finalLink;
  document.getElementById('genResult').style.display = "block";
}

function copyLink(){ navigator.clipboard.writeText(finalLink); alert("Link copy ho gaya!"); }
function sendWA(){
  let msg = `Assalam o Alaikum ${currentCustomer},%0AApka repayment pending hai.%0AIs link par click kar ke pay kar dein:%0A${encodeURIComponent(finalLink)}`;
  let num = currentMobile.replace(/[^0-9]/g,'');
  if(num.length==10) num = "92"+num;
  if(num.startsWith("0")) num = "92"+num.substring(1);
  window.open(`https://wa.me/${num}?text=${msg}`, '_blank');
}

function selectChannel(i){
  selectedChannel = i;
  let btns = document.querySelectorAll('.channels button');
  btns.forEach((b, idx)=>{ b.classList.toggle('active', idx===i); });
  document.getElementById('selectedUpi').innerText = "Selected: " + channels[i].upi;
}

function payNow(type){
  let amt = type === 'Full' ? fullAmtVal : extAmtVal;
  let upi = channels[selectedChannel].upi;
  let link = `upi://pay?pa=${encodeURIComponent(upi)}&pn=${encodeURIComponent(bizVal)}&am=${encodeURIComponent(amt)}&cu=INR&tn=${encodeURIComponent(type + " - " + bizVal)}`;
  window.location.href = link;
}

// Agar link me data hai to Customer Page dikhao
window.onload = ()=>{
  if(getParam('biz')){
    document.getElementById('generatorPage').style.display = "none";
    document.getElementById('customerPage').style.display = "block";
    bizVal = getParam('biz');
    extAmtVal = getParam('ext');
    fullAmtVal = getParam('full');
    document.getElementById('showBiz').innerText = bizVal;
    document.getElementById('showDays').innerText = getParam('days');
    document.getElementById('showExt').innerText = Number(extAmtVal).toLocaleString('en-IN');
    document.getElementById('showFull').innerText = Number(fullAmtVal).toLocaleString('en-IN');
    document.getElementById('showUnlocked').innerText = Number(getParam('unlocked')).toLocaleString('en-IN') + ".00";
    channels = [];
    for(let i=1;i<=5;i++){
      let u = getParam('upi'+i);
      if(u) channels.push({name:"Channel "+i, upi:u});
    }
    let container = document.getElementById('channelBtns');
    channels.forEach((ch, idx)=>{
      let b = document.createElement('button');
      b.innerText = ch.name;
      b.onclick = ()=> selectChannel(idx);
      container.appendChild(b);
    });
    selectChannel(0);
  }
}
</script>
</body>
</html>
